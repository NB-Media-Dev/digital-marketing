nv# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:4200

# ── Database (MySQL 8+ via Prisma) ───────────────────────
DATABASE_URL="mysql://root:1234@localhost:3306/markops"

# ── Auth (JWT) ───────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# ── Meta / Facebook Ads ──────────────────────────────────
# When META_APP_ID / META_APP_SECRET are blank, Meta runs in MOCK/demo mode
# (Settings → Integrations offers "Connect (demo)"; sync uses simulated insights).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/meta/callback
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=markops-verify
META_SYNC_CRON=*/15 * * * *

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
